# Copy to .env and fill in from your Supabase project settings.
# These are the *publishable* credentials — safe to ship in a client app,
# because Row Level Security is what actually protects the data.
# Never put the service_role key here; it bypasses RLS entirely.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx
